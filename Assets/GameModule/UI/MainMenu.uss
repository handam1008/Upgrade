/* ---------- 메인 메뉴 ---------- */
.menu-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-font-definition: url("project://database/Assets/Font/x10y12pxDenkiChipHangul.ttf");
}

/* 화면 가장자리를 어둡게 눌러 가운데로 시선을 모은다 */
.vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(10, 6, 5, 0.35);
}

/* ---------- 배경 ---------- */
.bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #17100E;
    overflow: hidden;
}

/* 가운데에서 번지는 따뜻한 빛. 원을 겹쳐서 부드럽게 보이게 한다 */
.glow {
    position: absolute;
    align-self: center;
    transform-origin: center;
}

.glow--outer {
    width: 1100px;
    height: 1100px;
    top: -180px;
    border-radius: 550px;
    background-color: rgba(122, 66, 40, 0.16);
}

.glow--mid {
    width: 720px;
    height: 720px;
    top: 10px;
    border-radius: 360px;
    background-color: rgba(160, 92, 52, 0.16);
}

.glow--core {
    width: 380px;
    height: 380px;
    top: 180px;
    border-radius: 190px;
    background-color: rgba(214, 140, 70, 0.14);
    transition-duration: 3s;
    transition-property: scale, opacity;
    transition-timing-function: ease-in-out;
}

.glow--core--pulse {
    scale: 1.18 1.18;
    opacity: 0.55;
}

/* 비스듬히 지나가는 빛줄기 */
.streak {
    position: absolute;
    width: 2400px;
    height: 120px;
    background-color: rgba(232, 162, 79, 0.05);
    rotate: -22deg;
}

.streak--a { top: 130px;  left: -600px; }
.streak--b { top: 520px;  left: -800px; height: 60px; background-color: rgba(232, 162, 79, 0.035); }

/* 떠다니는 불티 */
.ember {
    position: absolute;
    width: 6px;
    height: 6px;
    background-color: #E8A24F;
    opacity: 0.15;
    transition-property: translate, opacity;
    transition-timing-function: ease-in-out;
}

.ember--big {
    width: 10px;
    height: 10px;
    background-color: #F0C07A;
}

.ember--float {
    translate: 0 -46px;
    opacity: 0.85;
}

/* ---------- 탑 실루엣 ---------- */
/* 높고 좁게. 몸통 폭을 일정하게 두고 띠로만 층을 나눈다 */
.tower {
    position: absolute;
    bottom: 0;
    left: 15%;
    align-items: center;
}

.tower__seg {
    width: 148px;
    height: 104px;
    background-color: #150E0B;
    align-items: center;
    justify-content: center;
}

/* 몸통보다 살짝 넓은 띠. 층이 나뉘어 보인다 */
.tower__band {
    width: 172px;
    height: 12px;
    background-color: #2E2019;
}

/* 처마. 몸통보다 확실히 넓게 튀어나와야 탑처럼 보인다 */
.tower__roof {
    width: 206px;
    height: 20px;
    background-color: #2E2019;
    border-top-width: 4px;
    border-top-color: #4A352C;
}

.tower__turret {
    width: 104px;
    height: 92px;
    background-color: #150E0B;
    align-items: center;
    justify-content: center;
}

.tower__cap {
    width: 128px;
    height: 16px;
    background-color: #2E2019;
    border-top-width: 3px;
    border-top-color: #4A352C;
}

.tower__spire {
    width: 22px;
    height: 74px;
    background-color: #2E2019;
}

.tower__beacon {
    width: 18px;
    height: 18px;
    margin-bottom: 6px;
    background-color: #7ED8E8;
    transition-duration: 1.4s;
    transition-property: scale, background-color;
    transition-timing-function: ease-in-out;
}

.tower__beacon--pulse {
    scale: 1.7 1.7;
    background-color: #D8F6FF;
}

.tower__flag {
    width: 30px;
    height: 18px;
    margin-bottom: 4px;
    margin-left: 30px;
    background-color: #D94F3D;
}

.tower__base {
    width: 214px;
    height: 78px;
    background-color: #0F0A08;
    align-items: center;
    justify-content: flex-end;
}

.tower__door {
    width: 40px;
    height: 52px;
    background-color: #060403;
    border-top-width: 3px;
    border-top-color: #4A352C;
}

/* 세로로 긴 창. 탑의 수직감을 살린다 */
.tower__win {
    width: 14px;
    height: 34px;
    background-color: #3A2A18;
    transition-duration: 1.1s;
    transition-property: background-color;
    transition-timing-function: ease-in-out;
}

.tower__win--sm {
    height: 24px;
}

.tower__win--lit {
    background-color: #F7D089;
}

/* ---------- 타이틀 ---------- */
.title-group {
    align-items: center;
    margin-bottom: 70px;
}

.title-sub {
    color: #A88F6E;
    font-size: 26px;
    letter-spacing: 8px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.9);
}

.title-main {
    color: #F4E4C8;
    font-size: 96px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    text-shadow: 6px 6px 0 rgba(0, 0, 0, 0.9);
    transform-origin: center;
    transition-duration: 2.2s;
    transition-property: scale, color;
    transition-timing-function: ease-in-out;
}

/* 코드에서 붙였다 뗐다 하며 천천히 숨쉬게 만든다 */
.title-main--breathe {
    scale: 1.04 1.04;
    color: #FFF3C4;
}

.title-line {
    height: 4px;
    width: 340px;
    margin-top: 18px;
    background-color: #8A6A4A;
}

/* ---------- 버튼 ---------- */
.menu-buttons {
    align-items: center;
}

.menu-button {
    width: 320px;
    height: 74px;
    font-size: 28px;
    color: #F4E4C8;
    background-color: #4A352C;
    border-width: 4px;
    border-color: #241813;
    margin-bottom: 18px;
    -unity-text-align: middle-center;
    transform-origin: center;
    transition-duration: 0.12s;
    transition-property: scale, background-color, border-color, color;
    transition-timing-function: ease-out;
}

.menu-button:hover {
    scale: 1.06 1.06;
    background-color: #6B4E3D;
    border-color: #8A6A4A;
    color: #FFF3C4;
}

.menu-button:active {
    scale: 0.97 0.97;
}

.menu-button--start:hover {
    border-color: #8ED166;
}

.menu-button--quit {
    width: 220px;
    height: 58px;
    font-size: 22px;
    color: #A88F6E;
}

.menu-button--quit:hover {
    border-color: #E8604F;
    color: #F4E4C8;
}

/* ---------- 조작법 창 ---------- */
.tutorial-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 5, 4, 0.82);
    display: none;
}

.tutorial-frame {
    background-color: #4A352C;
    border-width: 4px;
    border-color: #241813;
    padding: 5px;
}

.tutorial-inner {
    background-color: #211611;
    border-width: 3px;
    border-color: #8A6A4A;
    align-items: center;
    padding-top: 52px;
    padding-bottom: 46px;
    padding-left: 90px;
    padding-right: 90px;
}

.tutorial-title {
    color: #F4E4C8;
    font-size: 58px;
    letter-spacing: 6px;
    margin-bottom: 32px;
    -unity-text-align: middle-center;
    text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.9);
}

.tutorial-guide {
    color: #E8C89A;
    font-size: 32px;
    margin-bottom: 38px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.tutorial-divider {
    height: 4px;
    width: 100%;
    margin-bottom: 40px;
    background-color: #8A6A4A;
}

/* ---------- 키 안내 ---------- */
.key-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 44px;
}

.key-item {
    align-items: center;
    margin-left: 22px;
    margin-right: 22px;
}

.key-cap {
    min-width: 132px;
    height: 86px;
    background-color: #2E2019;
    border-width: 4px;
    border-color: #8A6A4A;
    border-bottom-width: 10px;
    align-items: center;
    justify-content: center;
    padding-left: 20px;
    padding-right: 20px;
}

.key-cap__text {
    color: #F7D089;
    font-size: 30px;
    -unity-text-align: middle-center;
}

.key-item__label {
    color: #A88F6E;
    font-size: 26px;
    margin-top: 16px;
    -unity-text-align: middle-center;
}

.menu-button--tutorial {
    width: 260px;
    height: 62px;
    font-size: 24px;
}

/* ---------- 버전 ---------- */
.version-label {
    position: absolute;
    right: 24px;
    bottom: 18px;
    color: #6B5443;
    font-size: 16px;
}
