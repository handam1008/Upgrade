/* ---------- 확인창 ---------- */
.dialog-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    -unity-font-definition: url("project://database/Assets/Font/x10y12pxDenkiChipHangul.ttf");
}

.dialog-frame {
    min-width: 460px;
    background-color: #4A352C;
    border-width: 4px;
    border-color: #241813;
    padding: 5px;
}

.dialog-inner {
    background-color: #2A1E1C;
    border-width: 3px;
    border-color: #8A6A4A;
    align-items: center;
    padding-top: 28px;
    padding-bottom: 22px;
    padding-left: 26px;
    padding-right: 26px;
}

.dialog-message {
    color: #F4E4C8;
    font-size: 22px;
    margin-bottom: 26px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.dialog-buttons {
    flex-direction: row;
    justify-content: center;
}

.dialog-button {
    min-width: 130px;
    height: 52px;
    font-size: 20px;
    color: #F4E4C8;
    border-width: 3px;
    border-color: #241813;
    margin-left: 8px;
    margin-right: 8px;
    -unity-text-align: middle-center;
    transition-duration: 0.08s;
    transition-property: background-color, scale;
}

.dialog-button:hover {
    scale: 1.05 1.05;
}

.dialog-button:active {
    scale: 0.96 0.96;
}

.dialog-button--yes {
    background-color: #4A8F3A;
    border-color: #8ED166;
}

.dialog-button--yes:hover {
    background-color: #5FAE4B;
}

.dialog-button--no {
    background-color: #7A2B25;
    border-color: #E8604F;
}

.dialog-button--no:hover {
    background-color: #9A3830;
}
